# KorgenKassa VPS reverse proxy (HTTPS via certbot).
# Replace example.kz with your ps.kz (or other) domain.
#
# After copying:
#   sudo certbot --nginx -d kassa.example.kz -d waiter.example.kz -d kds.example.kz

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

upstream flocafe_pos {
    server 127.0.0.1:3001;
}

upstream flocafe_kds {
    server 127.0.0.1:3002;
}

upstream flocafe_waiter {
    server 127.0.0.1:3003;
}

server {
    listen 80;
    listen [::]:80;
    server_name kassa.example.kz;

    # Hashed Next assets can be cached; HTML + SW must revalidate so Safari
    # cannot keep an old dish-grid CSS after a frontend/out replace.
    location /_next/static/ {
        proxy_pass http://flocafe_pos;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        expires 1y;
    }

    location = /sw.js {
        proxy_pass http://flocafe_pos;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        expires -1;
    }

    location / {
        proxy_pass http://flocafe_pos;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 3600s;
        expires -1;
    }
}

# Waiter phones: https://waiter.example.kz  (or use https://kassa.example.kz/server-standalone)
server {
    listen 80;
    listen [::]:80;
    server_name waiter.example.kz;

    location / {
        proxy_pass http://flocafe_waiter;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 3600s;
    }
}

# Kitchen display (optional)
server {
    listen 80;
    listen [::]:80;
    server_name kds.example.kz;

    location / {
        proxy_pass http://flocafe_kds;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 3600s;
    }
}
